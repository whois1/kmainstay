[Unit]
Description=K-Mainstay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kmainstay
Group=kmainstay
WorkingDirectory=/var/lib/kmainstay
Environment=DB_PATH=/var/lib/kmainstay/kmainstay.db
Environment=ATTACHMENT_PATH=/var/lib/kmainstay/uploads
Environment=LISTEN_ADDR=127.0.0.1:8080
ExecStart=/opt/kmainstay/kmainstay
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/kmainstay
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
